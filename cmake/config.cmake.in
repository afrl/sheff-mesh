cmake_policy(SET CMP0048 NEW)

project(flex_mesh VERSION 1.0.0 LANGUAGES CXX)

cmake_minimum_required(VERSION 3.8)

# Options


# Guard against in-source builds
if(${CMAKE_SOURCE_DIR} STREQUAL ${CMAKE_BINARY_DIR})
	message(FATAL_ERROR "In-source builds not allowed. Please make a new directory (called a build directory) and run CMake from there. You may need to remove CMakeCache.txt.")
endif()

# Guard against empty build-type strings
if (NOT CMAKE_BUILD_TYPE)
	set(CMAKE_BUILD_TYPE "Release")
endif()

# Guard against invalid build-type strings
string(TOLOWER "${CMAKE_BUILD_TYPE}" cmake_build_type_tolower)
if(NOT cmake_build_type_tolower STREQUAL "debug"
   AND NOT cmake_build_type_tolower STREQUAL "release"
   AND NOT cmake_build_type_tolower STREQUAL "relwithdebinfo")
  message(FATAL_ERROR "Unknown build type \"${CMAKE_BUILD_TYPE}\". Allowed values are Debug, Release, RelWithDebInfo (case-insensitive).")
endif()

# Ensure we have C++ 11 support
include(CheckCXXCompilerFlag)
check_cxx_compiler_flag("-std=c++11" FLEX_MESH_COMPILER_SUPPORT_CPP11)
if(NOT FLEX_MESH_COMPILER_SUPPORT_CPP11)
	message(FATAL_ERROR "The compiler must support C++ 11.")
endif()

# Find MPI
find_package(MPI)
if(MPI_FOUND)
	include_directories(${MPI_INCLUDE_PATH})
endif()

# Set the variables for flex_mesh
set(FLEX_MESH_TARGET_NAME ${PROJECT_NAME})
set(FLEX_MESH_INCLUDE ${CMAKE_SOURCE_DIR}/include)
set(FLEX_MESH_INCLUDE_SUB ${FLEX_MESH_INCLUDE}/flex_mesh)
file (GLOB_RECURSE FLEX_MESH_HEADER_LIST "${FLEX_MESH_INCLUDE}/*.h")
set(FLEX_MESH_CONFIG_INSTALL_DIR "lib/cmake/${PROJECT_NAME}" CACHE INTERNAL "")
set(FLEX_MESH_INCLUDE_INSTALL_DIR "include")
set(FLEX_MESH_TARGETS_EXPORT_NAME "${PROJECT_NAME}Targets")
set(FLEX_MESH_CMAKE_CONFIG_TEMPLATE "cmake/config.cmake.in")
set(FLEX_MESH_CMAKE_CONFIG_DIR "${CMAKE_CURRENT_BINARY_DIR}")
set(FLEX_MESH_CMAKE_VERSION_CONFIG_FILE "${FLEX_MESH_CMAKE_CONFIG_DIR}/${PROJECT_NAME}ConfigVersion.cmake")
set(FLEX_MESH_CMAKE_PROJECT_CONFIG_FILE "${FLEX_MESH_CMAKE_CONFIG_DIR}/${PROJECT_NAME}Config.cmake")
set(FLEX_MESH_CMAKE_PROJECT_TARGETS_FILE "${FLEX_MESH_CMAKE_CONFIG_DIR}/${PROJECT_NAME}Targets.cmake")

# Create header-only target
add_library(${FLEX_MESH_TARGET_NAME} INTERFACE)
target_compile_features(${FLEX_MESH_TARGET_NAME} INTERFACE cxx_std_11)
target_include_directories(${FLEX_MESH_TARGET_NAME} INTERFACE ${FLEX_MESH_INCLUDE})
target_sources(${FLEX_MESH_TARGET_NAME} INTERFACE ${FLEX_MESH_HEADER_LIST})

# For targets that use this project they should call assign_source_group(${FLEX_MESH_HEADER_LIST})
# in order to group the files by the directories they are in within Visual Studio.
function(assign_source_group)
    foreach(_source IN ITEMS ${ARGN})
        if (IS_ABSOLUTE "${_source}")
            file(RELATIVE_PATH _source_rel "${FLEX_MESH_INCLUDE}" "${_source}")
        else()
            set(_source_rel "${_source}")
        endif()
        get_filename_component(_source_path "${_source_rel}" PATH)
		string(REPLACE "/" "\\" _source_path_msvc "${_source_path}")
        source_group("${_source_path_msvc}" FILES "${_source}")
    endforeach()
endfunction(assign_source_group)
set_property(GLOBAL PROPERTY USE_FOLDERS ON)



# Install
include(CMakePackageConfigHelpers)
write_basic_package_version_file(${FLEX_MESH_CMAKE_VERSION_CONFIG_FILE} COMPATIBILITY SameMajorVersion)
configure_file(
	${FLEX_MESH_CMAKE_CONFIG_TEMPLATE}
    ${FLEX_MESH_CMAKE_PROJECT_CONFIG_FILE}
    @ONLY
)
install(
	DIRECTORY ${FLEX_MESH_INCLUDE_SUB}
    DESTINATION ${FLEX_MESH_INCLUDE_INSTALL_DIR}
)
install(
    FILES ${FLEX_MESH_CMAKE_PROJECT_CONFIG_FILE} ${FLEX_MESH_CMAKE_VERSION_CONFIG_FILE}
    DESTINATION ${FLEX_MESH_CONFIG_INSTALL_DIR}
)
export(
    TARGETS ${FLEX_MESH_TARGET_NAME}
    NAMESPACE ${PROJECT_NAME}::
    FILE ${FLEX_MESH_CMAKE_PROJECT_TARGETS_FILE}
)
